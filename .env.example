# ---- Database (PostgreSQL) -------------------------------------------------
# Pooled connection string used by the app at runtime (Neon / Supabase pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Optional: direct (non-pooled) connection used only for `prisma migrate`.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ---- Auth.js / NextAuth -----------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# Your site URL. Local: http://localhost:3000   Vercel: https://your-app.vercel.app
# (On Vercel preview deployments NextAuth falls back to VERCEL_URL.)
NEXTAUTH_URL="http://localhost:3000"

# ---- OAuth providers (leave blank to hide the button) -----------------------
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: https://github.com/settings/developers
#   Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- Reminders cron (Vercel Cron sends this as a Bearer token) ---------------
CRON_SECRET=""

# ---- File uploads (optional, AWS S3) -----------------------------------------
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
